{
  "cli": {
    "version": ">= 20.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "scheme": "App",
        "projectPath": "ios/App/App.xcodeproj"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "scheme": "App",
        "projectPath": "ios/App/App.xcodeproj"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "scheme": "App",
        "projectPath": "ios/App/App.xcodeproj"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
